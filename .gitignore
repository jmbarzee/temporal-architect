# Dependencies
node_modules/

*.npm-cache

# Orphan root lockfile — this repo has no root npm package; npm only runs under
# tools/visualizer and tools/wire-types. A stray `npm` at the repo root keeps
# re-creating an empty package-lock.json here. Root-anchored so it never touches
# the real tools/* lockfiles.
/package-lock.json

# Publish tokens (contains secrets)
.env.publish

# Visualizer build artifacts
tools/visualizer/dist/
tools/visualizer/dist-lib/

# LICENSE copies generated by package prepack hooks
# (the canonical copy lives at the repo root)
tools/visualizer/LICENSE
tools/wire-types/LICENSE

# Visualizer doc fragment copied in by prepack (canonical: docs/fragments/visualizer.md)
tools/visualizer/FRAGMENT.md

# Release packaging staging (binary, archives, skills/visualizer/wire-types tarballs)
dist/

# Built Go binaries
tools/lsp/twf

# Claude settings
.claude/settings.local.json
examples/.claude/settings.local.json
internal/orchestrator/.claude/settings.local.json

# skills used to build examples
examples/.claude/skills

internal/release/gen-skills-manifest/gen-skills-manifest

# Distribution repo working tree (seeded locally inside the workspace; its own
# git repo, never tracked by the toolchain repo)
/temporal-architect-dist/

internal/changes/temp-change-set/ai-use-case-review/*

# Compiled sampler binary (built at repo root by `go build ./tools/sampler`)
/sampler
