%% The Erlang corpus: a rebar3 project beside mix.exs. rebar.config.script adds erlang_support/
%% and each design's erlang/ directory as both a source and a Common Test directory, so a new
%% design needs no edit. Its build lives under _build/rebar3/, clear of mix's _build/<env>/.
{base_dir, "_build/rebar3"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% main at d2749c7 is MIT; the Hex 0.2.x releases are BUSL-1.1.
    {temporal_sdk,
        {git, "https://github.com/andrzej-mag/temporal_sdk.git",
            {ref, "d2749c77a74032f466345f476861a59180086fbd"}}}
]}.
