<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="php/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="phpunit-bootstrap.php"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         colors="true">
    <testsuites>
        <testsuite name="corpus">
            <directory suffix="Test.php">messages/php</directory>
            <directory suffix="Test.php">concurrency/php</directory>
            <directory suffix="Test.php">continue-as-new/php</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="TEMPORAL_ADDRESS" value="127.0.0.1:7233"/>
    </php>
</phpunit>
